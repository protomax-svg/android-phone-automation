# Settings for the web control panel (./web.sh). Read by web/server.py.

# 127.0.0.1 = only this PC can open the panel (recommended: the panel can drive the phone
# and run Claude). Use 0.0.0.0 to allow your LAN - then anyone on the LAN can control it,
# and live video needs https or localhost (browsers allow WebCodecs only in secure contexts).
WEB_HOST=127.0.0.1
WEB_PORT=8765

# Model for the chat (empty = your Claude Code default), e.g. claude-sonnet-5-5
CLAUDE_MODEL=
# Optional spend cap per request in USD (empty = none)
CLAUDE_MAX_BUDGET_USD=
