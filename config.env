# Settings for start.sh (sourced by bash). Command-line flags override these.

# 1 = turn the phone's physical display off while mirroring (control stays active;
#     the phone is NOT unlocked by this, it only blanks the panel). Same as --screen-off.
SCRCPY_SCREEN_OFF=0

# Keep the phone awake while plugged in and scrcpy runs (restored on exit).
SCRCPY_STAY_AWAKE=1

# Limit mirrored resolution (long side, px). 0 = native.
# This phone (Redmi Note 11) cannot H.264-encode native 1080x2400: it falls back to
# 488x1088. 1920 gives a clean 864x1920 stream (tested).
SCRCPY_MAX_SIZE=1920

# Video bitrate and codec (h264 is the most compatible).
SCRCPY_VIDEO_BITRATE=8M
SCRCPY_VIDEO_CODEC=h264

# Extra raw scrcpy flags, e.g. "--no-audio --show-touches"
SCRCPY_EXTRA_FLAGS=""
